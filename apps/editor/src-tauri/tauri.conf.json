{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photo Calendar",
  "version": "0.1.0",
  "identifier": "com.photocalendar.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "照片日历编辑器",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "shortDescription": "为照片日历添加照片、生成文案并发布到 GitHub Pages",
    "longDescription": "照片日历的跨平台编辑器。导入照片、解析 EXIF、调用 DeepSeek 生成文案，并通过 Git 发布到站点仓库。"
  }
}
